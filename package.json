{
  "name": "agent-mikrotik",
  "type": "module",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"bun run --cwd apps/api dev\" \"bun run --cwd apps/web dev\"",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/api build",
    "typecheck": "tsc -b tsconfig.json",
    "lint": "eslint .",
    "test": "bun test",
    "test:ui": "bun run --cwd apps/web test",
    "test:e2e": "playwright test",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:migrate": "bun run --cwd apps/api db:migrate"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@playwright/test": "1.55.1",
    "concurrently": "9.2.1",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8"
  }
}
