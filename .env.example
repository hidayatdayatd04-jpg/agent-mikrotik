# Template konfigurasi — SEMUA nilai adalah placeholder, bukan secret nyata.
# Salin ke .env dan isi sesuai lingkungan. Jangan commit .env.

NODE_ENV=development
APP_NAME="MikroTik AI Agent"
APP_URL=http://localhost:3000
API_PORT=3001
TRUSTED_ORIGINS=http://localhost:3000

# Database (Neon di production; Postgres lokal Docker di development)
DATABASE_URL=<neon-pooled-url-atau-postgres-lokal>
DATABASE_URL_DIRECT=<neon-direct-url-opsional>

# Google OAuth (opsional di development — mock aktif bila kosong)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Brevo Transactional Email (opsional di development — OTP dicetak ke log bila kosong)
BREVO_API_KEY=<brevo-transactional-api-key>
BREVO_SENDER_NAME="MikroTik AI Agent"
BREVO_SENDER_EMAIL=<verified-sender-email>

# Anthropic (opsional di development — provider mock deterministik bila kosong)
ANTHROPIC_API_KEY=<anthropic-api-key>
ANTHROPIC_MODEL=<model-yang-diverifikasi>

# Enkripsi kredensial router — WAJIB sebelum menyimpan connector
# Generate: openssl rand -base64 32
ROUTER_CREDENTIAL_KEY=<base64-32-byte-key>
ROUTER_CREDENTIAL_KEY_VERSION=1

# OTP
OTP_HMAC_SECRET=<random-secret-terpisah>
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
SESSION_TTL_SECONDS=604800

# Storage (Backblaze B2 di production; MinIO Docker di development)
B2_KEY_ID=<b2-key-id-atau-minio-access-key>
B2_APPLICATION_KEY=<b2-application-key-atau-minio-secret>
B2_BUCKET=<private-bucket-name>
B2_REGION=<b2-region>
B2_ENDPOINT=<b2-s3-endpoint-atau-http://localhost:9000>
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_MESSAGE=4

# MCP process supervision
MCP_BUN_EXECUTABLE=bun
ROSETTA_DATA_DIR=./corpus
ROUTER_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8
SSH_CONNECT_TIMEOUT_MS=10000
MCP_IDLE_TIMEOUT_SECONDS=900
MAX_MCP_PROCESSES_PER_USER=2
MAX_MCP_PROCESSES_TOTAL=20

# Agent
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=30
AGENT_RUN_TIMEOUT_MS=120000

LOG_LEVEL=info
