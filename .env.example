# Opsional untuk development. CLI tidak membutuhkan .env.
NODE_ENV=development
API_PORT=3001
# DATA_DIR=C:/Users/nama/.mikrotik-agent
# Key unik dibuat otomatis. Provider AI diatur melalui UI.
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_FILES_PER_MESSAGE=4
ROUTER_ALLOWED_CIDRS=192.168.0.0/16,10.0.0.0/8
SSH_CONNECT_TIMEOUT_MS=10000
MCP_IDLE_TIMEOUT_SECONDS=900
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=30
AGENT_RUN_TIMEOUT_MS=120000
MAX_ACTIONS_PER_TRANSACTION=20
# Rate limiter AI terpusat (default 4 RPM / 150.000 TPM per model; RPD mengikuti provider).
RATE_LIMIT_RPM=4
RATE_LIMIT_TPM=150000
RATE_LIMIT_MAX_QUEUE=50
RATE_LIMIT_MAX_WAIT_MS=300000
RATE_LIMIT_MAX_RETRIES=3
# Override JSON opsional bila limit resmi provider lebih rendah:
# {"providers":{"gemini":{"rpm":2}},"models":{"gemini:gemini-2.0-flash":{"tpm":60000}},"shared":{}}
#RATE_LIMIT_OVERRIDES_JSON=
# Presisi tool-calling agent: rendah = argumen konsisten & minim halusinasi
# (0.1–0.3 disarankan; 0 = deterministik penuh, berisiko pola ulang saat retry).
AI_TEMPERATURE=0.15
LOG_LEVEL=info
