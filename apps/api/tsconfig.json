{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "bun"
    ],
    "composite": true,
    "declaration": true,
    "noEmit": true,
    "lib": [
      "ES2022"
    ],
    "skipLibCheck": true,
    "paths": {
      "@shared/*": [
        "../../packages/shared/src/*"
      ],
      "@mikrotik-tools/*": [
        "../../packages/mikrotik-tools/src/*"
      ]
    }
  },
  "include": [
    "src",
    "../../packages/shared/src",
    "../../packages/mikrotik-tools/src"
  ]
}
